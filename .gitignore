.venv/
.tools/
__pycache__/
*.pyc
.research/
results/
paper/build/*
paper/generated/*.tex
paper/figures/*.pdf
paper/figures/*.svg
blog-handoff/

# Portable evidence must survive Git ignore rules for generated outputs.
!evidence/archive/
!evidence/archive/**

# Imported-evidence manuscript: keep generated sources, converted figures and the publishable PDF.
!paper/build/main.pdf
!paper/generated/*.tex
!paper/figures/*.pdf

# Runtime companion inputs/outputs are local; imported archives remain tracked.
companion/data/
companion/runs/
companion/out*/
.pytest_cache/
